# Copier ce fichier en .env et remplacer toutes les valeurs « changez-moi ».

# ---- Base de données
POSTGRES_DB=altiumlib
POSTGRES_USER=altium
POSTGRES_PASSWORD=changez-moi-mot-de-passe-long

# Compte en lecture seule utilisé par Altium (ODBC). Il ne voit que les tables de composants validés.
ALTIUM_RO_USER=altium_ro
ALTIUM_RO_PASSWORD=changez-moi-lecture

# ---- Application web
# Clé de signature des sessions : une longue chaîne aléatoire (ex. : openssl rand -hex 32)
SECRET_KEY=changez-moi-cle-aleatoire
# Adresse de l'application telle que les postes la voient (sert aux liens datasheet dans Altium)
PUBLIC_URL=http://srv-altium:8080
# Nom ou IP du serveur tel qu'il apparaîtra dans la chaîne de connexion ODBC
ODBC_HOST=srv-altium
ODBC_PORT=5432
# Langue des noms de tables et de colonnes vus par Altium : fr ou en
ALTIUM_LANG=fr
# 1 si l'application est servie en HTTPS derrière un proxy
COOKIE_SECURE=0
# 1 = les liens datasheet /ds/... s'ouvrent sans connexion (réseau interne)
DATASHEETS_PUBLIC=1
MAX_UPLOAD_MB=150

# Premier administrateur, créé au premier démarrage seulement (base sans utilisateur)
ADMIN_EMAIL=dan@exemple.fr
ADMIN_PASSWORD=changez-moi-admin
ADMIN_NAME=Dan

# Facultatif : clé API Mouser (Search API) pour le bouton « Compléter via Mouser »
MOUSER_API_KEY=

# ---- Partage réseau (Samba) pour les fichiers SchLib/PcbLib
SMB_USER=altium
SMB_PASSWORD=changez-moi-partage
SMB_SHARE=altium-lib
SMB_WORKGROUP=WORKGROUP
# Chemin du partage tel qu'affiché aux utilisateurs
SHARE_UNC='\\srv-altium\altium-lib'

# ---- Ports publiés sur le serveur
APP_PORT=8080
DB_PORT=5432
SMB_PORT=445
